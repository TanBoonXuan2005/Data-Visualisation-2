{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How large are Australia's World Heritage properties?",
    "subtitle": "Symbol size shows listed area in five classes; colour shows the category. Hover for the exact area."
  },
  "width": 600,
  "height": 430,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states_2026"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/world_heritage_australia.csv"
      },
      "transform": [
        {
          "filter": "datum.name !== 'Heard and McDonald Islands' && datum.name !== 'Macquarie Island'"
        },
        {
          "calculate": "datum.area_ha < 10000 ? 'Under 10,000 ha' : datum.area_ha < 100000 ? '10,000 to 100,000 ha' : datum.area_ha < 1000000 ? '100,000 ha to 1 million' : datum.area_ha < 10000000 ? '1 to 10 million ha' : 'Over 10 million ha'",
          "as": "size_class"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "white",
        "strokeWidth": 0.8,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "size_class",
          "type": "ordinal",
          "title": "Listed area",
          "scale": {
            "domain": [
              "Under 10,000 ha",
              "10,000 to 100,000 ha",
              "100,000 ha to 1 million",
              "1 to 10 million ha",
              "Over 10 million ha"
            ],
            "range": [
              40,
              110,
              240,
              480,
              1300
            ],
            "type": "ordinal"
          },
          "legend": {
            "symbolType": "circle",
            "symbolFillColor": "#898781",
            "symbolStrokeWidth": 0,
            "labelFontSize": 11
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "title": "Heritage category",
          "scale": {
            "domain": [
              "Cultural",
              "Natural",
              "Mixed"
            ],
            "range": [
              "#2a78d6",
              "#1baf7a",
              "#eda100"
            ]
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "World Heritage property"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Inscribed",
            "format": "d"
          },
          {
            "field": "area_ha",
            "type": "quantitative",
            "title": "Listed area (ha)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/world_heritage_australia.csv"
      },
      "transform": [
        {
          "filter": "toNumber(datum.unesco_id) === 154 || toNumber(datum.unesco_id) === 147 || toNumber(datum.unesco_id) === 447"
        },
        {
          "calculate": "toNumber(datum.unesco_id) === 154 ? 'Great Barrier Reef' : toNumber(datum.unesco_id) === 147 ? 'Kakadu' : 'Uluṟu–Kata Tjuṯa'",
          "as": "map_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 27,
        "dy": -10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#263238"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "map_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Hanken Grotesk, Helvetica Neue, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "anchor": "start"
    },
    "axis": {
      "labelFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}
