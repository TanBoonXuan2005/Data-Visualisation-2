{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What makes Australia's World Heritage properties significant?",
    "subtitle": [
      "Filled cells show the UNESCO criteria each property meets; numbers below each column count the properties.",
      "Rows are grouped by category, and by year of listing within each group. Key on the right."
    ]
  },
  "width": 480,
  "height": 500,
  "data": {
    "url": "data/world_heritage_australia.csv"
  },
  "transform": [
    {
      "calculate": "datum.category === 'Cultural' ? 1 : datum.category === 'Mixed' ? 2 : 3",
      "as": "category_order"
    },
    {
      "calculate": "datum.category_order * 10000 + datum.year",
      "as": "sort_key"
    },
    {
      "calculate": "indexof(datum.criteria, '(i)') >= 0 ? 1 : 0",
      "as": "i"
    },
    {
      "calculate": "indexof(datum.criteria, '(ii)') >= 0 ? 1 : 0",
      "as": "ii"
    },
    {
      "calculate": "indexof(datum.criteria, '(iii)') >= 0 ? 1 : 0",
      "as": "iii"
    },
    {
      "calculate": "indexof(datum.criteria, '(iv)') >= 0 ? 1 : 0",
      "as": "iv"
    },
    {
      "calculate": "indexof(datum.criteria, '(v)') >= 0 ? 1 : 0",
      "as": "v"
    },
    {
      "calculate": "indexof(datum.criteria, '(vi)') >= 0 ? 1 : 0",
      "as": "vi"
    },
    {
      "calculate": "indexof(datum.criteria, '(vii)') >= 0 ? 1 : 0",
      "as": "vii"
    },
    {
      "calculate": "indexof(datum.criteria, '(viii)') >= 0 ? 1 : 0",
      "as": "viii"
    },
    {
      "calculate": "indexof(datum.criteria, '(ix)') >= 0 ? 1 : 0",
      "as": "ix"
    },
    {
      "calculate": "indexof(datum.criteria, '(x)') >= 0 ? 1 : 0",
      "as": "x"
    },
    {
      "fold": [
        "i",
        "ii",
        "iii",
        "iv",
        "v",
        "vi",
        "vii",
        "viii",
        "ix",
        "x"
      ],
      "as": [
        "criterion",
        "met"
      ]
    },
    {
      "calculate": "{'i': \"Human creativity\", 'ii': \"Exchange of ideas\", 'iii': \"Cultural traditions\", 'iv': \"Buildings and landscapes\", 'v': \"Traditional land use\", 'vi': \"Beliefs or events\", 'vii': \"Exceptional beauty\", 'viii': \"Earth's history\", 'ix': \"Living ecosystems\", 'x': \"Biodiversity\"}[datum.criterion]",
      "as": "criterion_name"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "met",
          "as": "criterion_total"
        }
      ],
      "groupby": [
        "criterion"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "criterion",
      "type": "ordinal",
      "sort": [
        "i",
        "ii",
        "iii",
        "iv",
        "v",
        "vi",
        "vii",
        "viii",
        "ix",
        "x"
      ],
      "title": "UNESCO criterion (see key)",
      "axis": {
        "orient": "top",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "name",
      "type": "ordinal",
      "sort": {
        "field": "sort_key",
        "op": "min",
        "order": "ascending"
      },
      "title": null,
      "axis": {
        "labelLimit": 300,
        "labelFontSize": 12,
        "labelExpr": "replace(datum.label, 'Australian Fossil Mammal Sites (Riversleigh / Naracoorte)', 'Fossil Mammal Sites (Riversleigh / Naracoorte)')"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "fill": "#f2f2f2",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.met === 1"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "category",
          "type": "nominal",
          "title": "Property category",
          "scale": {
            "domain": [
              "Cultural",
              "Natural",
              "Mixed"
            ],
            "range": [
              "#2a78d6",
              "#1baf7a",
              "#eda100"
            ]
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "World Heritage Property"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "criterion",
            "type": "nominal",
            "title": "UNESCO criterion"
          },
          {
            "field": "criterion_name",
            "type": "nominal",
            "title": "Criterion means"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Inscribed",
            "format": "d"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "text": "Cultural criteria",
            "y": 112,
            "bold": 1
          },
          {
            "text": "Natural criteria",
            "y": 236,
            "bold": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#0b0b0b"
      },
      "encoding": {
        "x": {
          "value": 500
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "text": "i   Human creativity",
            "y": 130,
            "bold": 0
          },
          {
            "text": "ii   Exchange of ideas",
            "y": 146,
            "bold": 0
          },
          {
            "text": "iii   Cultural traditions",
            "y": 162,
            "bold": 0
          },
          {
            "text": "iv   Buildings and landscapes",
            "y": 178,
            "bold": 0
          },
          {
            "text": "v   Traditional land use",
            "y": 194,
            "bold": 0
          },
          {
            "text": "vi   Beliefs or events",
            "y": 210,
            "bold": 0
          },
          {
            "text": "vii   Exceptional beauty",
            "y": 254,
            "bold": 0
          },
          {
            "text": "viii   Earth's history",
            "y": 270,
            "bold": 0
          },
          {
            "text": "ix   Living ecosystems",
            "y": 286,
            "bold": 0
          },
          {
            "text": "x   Biodiversity",
            "y": 302,
            "bold": 0
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "normal",
        "color": "#374151"
      },
      "encoding": {
        "x": {
          "value": 500
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.met === 1"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "criterion_total",
              "as": "n"
            }
          ],
          "groupby": [
            "criterion"
          ]
        },
        {
          "calculate": "datum.n + (datum.n === 1 ? ' property' : '')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "fontSize": 11,
        "color": "#52514e",
        "y": {
          "expr": "height + 6"
        }
      },
      "encoding": {
        "x": {
          "field": "criterion",
          "type": "ordinal"
        },
        "text": {
          "field": "n",
          "type": "quantitative"
        },
        "y": null
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "color": "#52514e",
        "x": -6,
        "y": {
          "expr": "height + 6"
        },
        "text": "Properties meeting it"
      },
      "encoding": {
        "x": null,
        "y": null
      }
    }
  ],
  "config": {
    "font": "Hanken Grotesk, Helvetica Neue, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "anchor": "start"
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "grid": false,
      "domain": false,
      "ticks": false
    },
    "view": {
      "stroke": null
    }
  }
}
