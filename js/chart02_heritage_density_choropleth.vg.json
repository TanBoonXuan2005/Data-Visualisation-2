      "mark": {
        "type": "text",
        "x": 161.5,
        "y": {
          "expr": "height - 14"
        },
        "align": "center",
        "baseline": "top",
        "fontSize": 11,
        "color": "#374151",
        "text": "10 to 50"
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "x": 194,
        "x2": 257,
        "y": {
          "expr": "height - 30"
        },
        "y2": {
          "expr": "height - 18"
        },
        "fill": "#0d366b"
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "x": 225.5,
        "y": {
          "expr": "height - 14"
        },
        "align": "center",
        "baseline": "top",
        "fontSize": 11,
