{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where are they most concentrated?",
    "subtitle": "Listed places per 100,000 km² of land, by state and territory"
  },
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/National_Heritage_List_Australia.csv"
      },
      "transform": [
        {
          "filter": "datum.STATUS === 'Listed place' && datum.STATE !== 'EXT'"
        },
        {
          "aggregate": [
            {
              "op": "distinct",
              "field": "PLACE_ID",
              "as": "listed_places"
            }
          ],
          "groupby": [
            "STATE"
          ]
        },
        {
          "lookup": "STATE",
          "from": {
            "data": {
              "values": [
                {
                  "abbr": "NSW",
                  "state_name": "New South Wales"
                },
                {
                  "abbr": "VIC",
                  "state_name": "Victoria"
                },
                {
                  "abbr": "QLD",
                  "state_name": "Queensland"
                },
                {
                  "abbr": "SA",
                  "state_name": "South Australia"
                },
                {
                  "abbr": "WA",
                  "state_name": "Western Australia"
                },
                {
                  "abbr": "TAS",
                  "state_name": "Tasmania"
                },
                {
                  "abbr": "NT",
                  "state_name": "Northern Territory"
                },
                {
                  "abbr": "ACT",
                  "state_name": "Australian Capital Territory"
                }
              ]
            },
            "key": "abbr",
            "fields": [
              "state_name"
            ]
          }
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "australia_states_2026"
              }
            },
            "key": "properties.STATE_NAME_2026"
          },
          "as": "geo"
        },
        {
          "calculate": "datum.listed_places / datum.geo.properties.AREA_ALBERS_SQKM * 100000",
          "as": "places_per_100k_km2"
        },
        {
          "calculate": "datum.places_per_100k_km2 < 2 ? 'Under 2' : datum.places_per_100k_km2 < 10 ? '2 to 10' : datum.places_per_100k_km2 < 50 ? '10 to 50' : '50 or more'",
          "as": "density_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "places_per_100k_km2",
          "type": "quantitative",
          "title": "Places per 100,000 km²",
          "scale": {
            "type": "threshold",
            "domain": [
              2,
              10,
              50
            ],
            "range": [
              "#b7d3f6",
              "#5598e7",
              "#1c5cab",
              "#0d366b"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "listed_places",
            "type": "quantitative",
            "title": "Listed places"
          },
          {
            "field": "places_per_100k_km2",
            "type": "quantitative",
            "title": "Per 100,000 km²",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.1,
            "lat": -35.4,
            "lon2": 153.2,
            "lat2": -37.6
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#52514e",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 153.2,
            "lat": -37.6,
            "note": "ACT: 212"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#0b0b0b"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "x": 2,
        "y": {
          "expr": "height - 36"
        },
        "align": "left",
        "baseline": "bottom",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#0b0b0b",
        "text": "Places per 100,000 km²"
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "x": 2,
        "x2": 65,
        "y": {
          "expr": "height - 30"
        },
        "y2": {
          "expr": "height - 18"
        },
        "fill": "#b7d3f6"
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "x": 33.5,
        "y": {
          "expr": "height - 14"
        },
        "align": "center",
        "baseline": "top",
        "fontSize": 11,
